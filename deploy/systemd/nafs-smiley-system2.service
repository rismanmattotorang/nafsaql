# nafs-smiley-server for system2 (Phase 15, the Smiley Core backend; Linux AVX2 hosts). Install beside the llama-server
# units: sudo cp deploy/systemd/*.service /etc/systemd/system/ && sudo systemctl enable --now nafs-smiley-system2, then switch
# the gateway with POST /v1/system/backend {"name":"smiley"}. Paths assume the repository in /opt/nafs-aql.
[Unit]
Description=Nafs-Aql system2 (Smiley Core, Qwen3 GGUF)
After=network-online.target

[Service]
Type=simple
User=nafs
WorkingDirectory=/opt/nafs-aql
ExecStart=/opt/nafs-aql/rust/target/release/nafs-smiley-server -m models/Qwen3-4B-Thinking-2507-Q4_K_M.gguf --alias system2 -t 3 -c 8192 --slots 4 --host 127.0.0.1 --port 8202
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/nafs-aql/models
MemoryMax=8G

[Install]
WantedBy=multi-user.target
