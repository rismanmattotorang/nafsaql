# llama-server for system1 (OR-003, Linux AVX2 hosts). Install: sudo cp deploy/systemd/*.service /etc/systemd/system/
# and sudo systemctl enable --now nafs-llama-system1 nafs-gateway. Paths assume the repository in /opt/nafs-aql.
[Unit]
Description=Nafs-Aql system1 (llama-server, Qwen3 GGUF)
After=network-online.target

[Service]
Type=simple
User=nafs
WorkingDirectory=/opt/nafs-aql
ExecStart=/opt/nafs-aql/third_party/llama.cpp/build/bin/llama-server -m models/Qwen3-1.7B-Q4_K_M.gguf --alias system1 -t 4 -c 16384 -np 4 --host 127.0.0.1 --port 8001 --jinja --reasoning-format deepseek --cache-reuse 256 --metrics
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/nafs-aql/models
MemoryMax=8G

[Install]
WantedBy=multi-user.target
