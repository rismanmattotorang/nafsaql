# TLS termination in front of the gateway (SR-006). Caddy obtains and renews certificates automatically
# for a public NAFS_DOMAIN; for "localhost" it uses its internal CA. SSE and WebSocket pass through.
{$NAFS_DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy gateway:8080 {
		flush_interval -1
		transport http {
			read_timeout 30m
		}
	}
}
